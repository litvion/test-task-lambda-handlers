# Copy to .env (gitignored) for local runs. Never commit a real key.

# mock = offline keyword rules (no key, no cost); anthropic = Claude
PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

LOG_LEVEL=INFO
TOPICS=finance,technical,hr,marketing,sales,legal,support,other

# Cost controls
BATCH_SIZE=10
MAX_CONCURRENCY=3
MAX_BODY_CHARS=2000
CACHE_MAX_ENTRIES=1000
